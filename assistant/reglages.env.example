# =============================================================================
#  RÉGLAGES DE L'ASSISTANT IA — service nh-assistant et recherche (RAG)
# =============================================================================
#  1. Copier ce fichier en « reglages.env », dans ce même dossier assistant/
#  2. Générer le jeton :  php -r 'echo bin2hex(random_bytes(24)), PHP_EOL;'
#  3. Redémarrer le service :  systemctl restart nh-assistant
#
#  reglages.env est ignoré par git. Les variables d'environnement du même nom,
#  si elles existent, sont prioritaires.
#
#  Les connexions aux modèles (LLM + embedding bge-m3) ne sont PAS ici : voir
#  llm.env à la racine de nh-web (partagé avec les HIL de la dispo).
# =============================================================================

# --- Service (lu aussi par Laravel) ------------------------------------------
ASSISTANT_HOTE=127.0.0.1
ASSISTANT_PORT=8765
# Secret partagé entre Laravel et le service (obligatoire : vide = tout refusé)
ASSISTANT_JETON=

# --- Base vectorielle ---------------------------------------------------------
# Chemin relatif au dossier assistant/, ou absolu
ASSISTANT_CHROMA_DIR=../storage/app/assistant/chroma

# --- Recherche et réponses ----------------------------------------------------
# Morceaux de documents retrouvés par question (recherche sur tout le secteur)
ASSISTANT_TOP_K=6
# Morceaux ajoutés en plus depuis les documents prioritaires (dossier consulté)
ASSISTANT_TOP_K_DOSSIER=3
# Morceaux ajoutés en plus depuis les pièces jointes de la conversation
ASSISTANT_TOP_K_PJ=3
# Distance maximale d'un morceau pertinent (bge-m3 : ~0.6 pertinent, ~1.1 hors sujet)
ASSISTANT_SEUIL_DISTANCE=1.0
# Température des réponses (0 = stable, 0.3 = naturel)
ASSISTANT_TEMPERATURE=0.3
# Échanges précédents envoyés pour comprendre une question de suite
ASSISTANT_HISTORIQUE_TOURS=3

# --- Découpage des documents --------------------------------------------------
# ⚠️ Changer TAILLE_MORCEAU, TAILLE_MIN, FUSION_SECTIONS, PAR_PAGE ou CHEVAUCHEMENT
#    ne s'applique qu'aux documents déposés ENSUITE : redéposer les documents existants.
#    VOISINS s'applique immédiatement, sans redépôt.
# Taille visée d'un morceau, en caractères (le maximum vaut 1,875 fois cette valeur)
ASSISTANT_TAILLE_MORCEAU=600
# En dessous, un morceau est considéré comme petit
ASSISTANT_TAILLE_MIN=150
# oui : regrouper les petites sections avec la suivante (un titre n'est plus jamais seul)
ASSISTANT_FUSION_SECTIONS=oui
# oui : découper page par page ; non : mettre les pages bout à bout avant de découper
ASSISTANT_PAR_PAGE=non
# Caractères repris de la fin du morceau précédent (0 = aucun chevauchement)
ASSISTANT_CHEVAUCHEMENT=150
# Coût : un CHEVAUCHEMENT proche de TAILLE_MORCEAU ou des VOISINS élevés agrandissent beaucoup les
# extraits envoyés au LLM (plus lent, plus cher, risque de dépasser sa limite).
# Morceaux voisins ajoutés avant et après chaque morceau retrouvé (0 = aucun)
ASSISTANT_VOISINS=1

# --- Dépôt de documents (lu par Laravel) --------------------------------------
# Taille maximale d'un document, en Mo. Pour AUGMENTER cette limite, augmenter aussi :
#  - config/livewire.php, temporary_file_upload > rules : 'max:<Mo × 1024>' (en Ko) ;
#  - PHP : upload_max_filesize et post_max_size (voir docs/commandes.md §15) ;
#  - nginx s'il est devant l'application : client_max_body_size.
# Puis : php artisan config:clear (ou config:cache) et php artisan queue:restart.
ASSISTANT_TAILLE_MAX_MO=50
