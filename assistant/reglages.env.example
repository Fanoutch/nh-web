# =============================================================================
#  RÉGLAGES DE L'ASSISTANT IA — service nh-assistant et recherche (RAG)
# =============================================================================
#  1. Copier ce fichier en « reglages.env », dans ce même dossier assistant/
#  2. Générer le jeton :  php -r 'echo bin2hex(random_bytes(24)), PHP_EOL;'
#  3. Redémarrer le service :  systemctl restart nh-assistant
#
#  reglages.env est ignoré par git. Les variables d'environnement du même nom,
#  si elles existent, sont prioritaires.
#
#  Les connexions aux modèles (LLM + embedding bge-m3) ne sont PAS ici : voir
#  llm.env à la racine de nh-web (partagé avec les HIL de la dispo).
# =============================================================================

# --- Service (lu aussi par Laravel) ------------------------------------------
ASSISTANT_HOTE=127.0.0.1
ASSISTANT_PORT=8765
# Secret partagé entre Laravel et le service (obligatoire : vide = tout refusé)
ASSISTANT_JETON=

# --- Base vectorielle ---------------------------------------------------------
# Chemin relatif au dossier assistant/, ou absolu
ASSISTANT_CHROMA_DIR=../storage/app/assistant/chroma

# --- Recherche et réponses ----------------------------------------------------
# Morceaux de documents retrouvés par question
ASSISTANT_TOP_K=6
# Distance maximale d'un morceau pertinent (bge-m3 : ~0.6 pertinent, ~1.1 hors sujet)
ASSISTANT_SEUIL_DISTANCE=1.0
# Température des réponses (0 = stable, 0.3 = naturel)
ASSISTANT_TEMPERATURE=0.3
# Échanges précédents envoyés pour comprendre une question de suite
ASSISTANT_HISTORIQUE_TOURS=3

# --- Dépôt de documents (lu par Laravel) --------------------------------------
ASSISTANT_TAILLE_MAX_MO=50
