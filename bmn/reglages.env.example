# =============================================================================
#  RÉGLAGES LOCAUX — le SEUL fichier à adapter entre ce serveur et le bureau
# =============================================================================
#  1. Copier ce fichier en « reglages.env », dans ce même dossier bmn/
#  2. Remplir les valeurs ci-dessous
#  3. Vérifier :  python check_setup.py   puis   python llm_client.py --test
#
#  reglages.env est ignoré par git : ni la clé d'API ni le chemin du template
#  réel ne partent sur GitLab ou dans un zip. Les variables d'environnement du
#  même nom, si elles existent, sont prioritaires.
# =============================================================================


# -----------------------------------------------------------------------------
#  DISPO : template et mode de remplissage
# -----------------------------------------------------------------------------

# Template Excel à remplir. Chemin relatif au dossier bmn/, ou absolu.
# Le template réel contient des données : le déposer dans bmn/template/ (ce
# dossier est ignoré par git, sauf le template factice template.xlsx).
DISPO_TEMPLATE=template/template.xlsx

# true = remplissage par blocs machine (vrai template de dispo, onglet DISPO)
# false = remplissage en tableau plat (template factice des tests)
DISPO_BLOCS_ACTIF=false


# -----------------------------------------------------------------------------
#  LLM : déduction du nom de la pièce pour les lignes HIL
# -----------------------------------------------------------------------------
#  Format d'API attendu : OpenAI (/v1/chat/completions).
#  Compatible : OpenAI, Mistral, OpenRouter, Ollama, LM Studio, vLLM, llama.cpp.

# true = interroger le modèle pour les lignes HIL ; false = aucun appel réseau
LLM_ACTIF=false

# Adresse de l'API, SANS « /chat/completions » à la fin
#   OpenAI    : https://api.openai.com/v1
#   Ollama    : http://127.0.0.1:11434/v1
#   LM Studio : http://127.0.0.1:1234/v1
LLM_BASE_URL=https://api.openai.com/v1

# Nom exact du modèle, tel que le service l'expose
LLM_MODELE=

# Clé d'API (laisser vide si le service n'en demande pas, ex. Ollama local)
LLM_CLE_API=

# Délai max par appel, en secondes
LLM_TIMEOUT=120

# 0 = réponses les plus stables
LLM_TEMPERATURE=0
