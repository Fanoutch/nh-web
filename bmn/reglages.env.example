# =============================================================================
#  RÉGLAGES DE LA DISPO — template réel et mode de remplissage
# =============================================================================
#  1. Copier ce fichier en « reglages.env », dans ce même dossier bmn/
#  2. Remplir les valeurs ci-dessous
#  3. Vérifier :  python check_setup.py
#
#  reglages.env est ignoré par git. Les variables d'environnement du même nom,
#  si elles existent, sont prioritaires.
#
#  Les réglages du LLM ne sont PAS ici : voir llm.env à la racine de nh-web.
# =============================================================================


# -----------------------------------------------------------------------------
#  DISPO : template et mode de remplissage
# -----------------------------------------------------------------------------

# Template Excel à remplir. Chemin relatif au dossier bmn/, ou absolu.
# Le template réel contient des données : le déposer dans bmn/template/ (ce
# dossier est ignoré par git, sauf le template factice template.xlsx).
DISPO_TEMPLATE=template/template.xlsx

# true = remplissage par blocs machine (vrai template de dispo, onglet DISPO)
# false = remplissage en tableau plat (template factice des tests)
DISPO_BLOCS_ACTIF=false
