.venv/
__pycache__/
.pytest_cache/
logs/*
!logs/.gitkeep
data/output/*
!data/output/.gitkeep
data/archive/*
!data/archive/.gitkeep
data/incoming/*
!data/incoming/.gitkeep
*.zip

# Réglages locaux (clé d'API, chemin du template réel) : jamais dans git
reglages.env

# Templates réels (données réelles) : seul le template factice est versionné
template/*
!template/template.xlsx
