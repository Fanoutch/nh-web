# =============================================================================
#  RÉGLAGES DU LLM — un seul fichier pour tous les appels au modèle
# =============================================================================
#  Utilisé par :
#    - l'envoi des lignes HIL au modèle (pipeline de dispo, dossier bmn/)
#    - l'assistant IA du site (à venir)
#
#  1. Copier ce fichier en « llm.env », à la racine de nh-web (à côté de .env)
#  2. Remplir les valeurs ci-dessous
#  3. Vérifier :  bmn/.venv/bin/python bmn/llm_client.py --test
#
#  llm.env est ignoré par git : la clé ne part jamais sur GitHub, GitLab ou dans
#  un zip. Le .env de Laravel n'est pas concerné. Les variables d'environnement
#  du même nom, si elles existent, sont prioritaires.
#
#  Format d'API attendu : OpenAI (/v1/chat/completions).
#  Compatible : OpenAI, Mistral, OpenRouter, Chutes, Ollama, LM Studio, vLLM.
# =============================================================================

# true = interroger le modèle ; false = aucun appel réseau
LLM_ACTIF=false

# Adresse de l'API, SANS « /chat/completions » à la fin
#   Chutes    : https://llm.chutes.ai/v1
#   OpenAI    : https://api.openai.com/v1
#   Ollama    : http://127.0.0.1:11434/v1
#   LM Studio : http://127.0.0.1:1234/v1
LLM_BASE_URL=https://api.openai.com/v1

# Nom exact du modèle, tel que le service l'expose (ex. unsloth/Mistral-Nemo-Instruct-2407-TEE)
LLM_MODELE=

# Clé d'API (laisser vide si le service n'en demande pas, ex. Ollama local)
LLM_CLE_API=

# --- Certificat du service (réseau interne) ---------------------------------
# Un service interne à certificat auto-signé fait échouer la vérification TLS
# (« CERTIFICATE_VERIFY_FAILED »). Deux réponses possibles :
#
#   1. RECOMMANDÉ : faire confiance à l'autorité interne, la vérification reste active
# LLM_CA_BUNDLE=/etc/ssl/certs/ca-interne.pem
#
#   2. À DÉFAUT : ne plus vérifier l'identité du service (journalisé à chaque appel)
# LLM_VERIF_TLS=false

# Délai max par appel, en secondes
LLM_TIMEOUT=120

# 0 = réponses les plus stables
LLM_TEMPERATURE=0
